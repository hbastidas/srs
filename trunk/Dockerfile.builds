########################################################
FROM rockylinux:9 AS centos7-baseline
COPY . /srs
RUN dnf makecache -y \
 && dnf -y groupinstall "Development Tools" \
 && dnf install -y wget ca-certificates which automake autoconf cmake tcl nasm yasm perl unzip patch \
 && update-ca-trust && dnf clean all
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=off --gb28181=off && make

FROM rockylinux:9 AS centos7-no-webrtc
COPY . /srs
RUN dnf makecache -y \
 && dnf -y groupinstall "Development Tools" \
 && dnf install -y wget ca-certificates which automake autoconf cmake tcl nasm yasm perl unzip patch \
 && update-ca-trust && dnf clean all
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=off --gb28181=off --rtc=off && make

FROM rockylinux:9 AS centos7-no-asm
COPY . /srs
RUN dnf makecache -y \
 && dnf -y groupinstall "Development Tools" \
 && dnf install -y wget ca-certificates which automake autoconf cmake tcl nasm yasm perl unzip patch \
 && update-ca-trust && dnf clean all
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=off --gb28181=off --nasm=off --srtp-nasm=off && make

FROM rockylinux:9 AS centos7-all
COPY . /srs
RUN dnf makecache -y \
 && dnf -y groupinstall "Development Tools" \
 && dnf install -y wget ca-certificates which automake autoconf cmake tcl nasm yasm perl unzip patch \
 && update-ca-trust && dnf clean all
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=on --gb28181=on --apm=on --h265=on && make

FROM rockylinux:9 AS centos7-ansi-no-ffmpeg
COPY . /srs
RUN dnf makecache -y \
 && dnf -y groupinstall "Development Tools" \
 && dnf install -y wget ca-certificates which automake autoconf cmake tcl nasm yasm perl unzip patch \
 && update-ca-trust && dnf clean all
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=off --gb28181=off --cxx11=off --cxx14=off --ffmpeg-fit=off && make

########################################################
FROM ubuntu:noble AS ubuntu16-baseline
COPY . /srs
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wget ca-certificates build-essential pkg-config git automake autoconf libtool cmake nasm yasm perl unzip patch tclsh \
 && rm -rf /var/lib/apt/lists/*
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=off --gb28181=off && make

FROM ubuntu:noble AS ubuntu16-all
COPY . /srs
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wget ca-certificates build-essential pkg-config git automake autoconf libtool cmake nasm yasm perl unzip patch tclsh \
 && rm -rf /var/lib/apt/lists/*
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=on --gb28181=on && make

