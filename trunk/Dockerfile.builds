########################################################
FROM rockylinux:9 AS rocky9-baseline
COPY . /srs
RUN dnf makecache -y \
 && dnf -y install dnf-plugins-core \
 && dnf config-manager --set-enabled crb \
 && dnf -y install epel-release \
 && dnf -y groupinstall "Development Tools" \
 && dnf install -y wget ca-certificates which automake autoconf cmake tcl nasm yasm perl unzip patch xz zlib-devel libasan \
 && update-ca-trust && dnf clean all
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=off --gb28181=off && make

