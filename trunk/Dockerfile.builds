FROM --platform=$TARGETPLATFORM ubuntu:24.04 AS ubuntu24-cache-cross-armv7
COPY . /srs
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wget ca-certificates build-essential pkg-config git automake autoconf libtool cmake nasm yasm perl unzip xz-utils patch tclsh \
    libopus-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*
RUN cd /srs/trunk && ./configure --sanitizer=on --ffmpeg-opus=on --sys-ssl=on && make

