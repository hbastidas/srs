FROM ubuntu:24.04

ARG MAKEARGS
RUN echo "MAKEARGS: ${MAKEARGS}"

ENV DEBIAN_FRONTEND=noninteractive

# Build and test dependencies
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    gcc g++ make patch unzip perl git ca-certificates wget libssl-dev \
    automake autoconf libtool cmake pkg-config nasm yasm xz-utils tclsh \
    zlib1g-dev liblzma-dev golang-go \
    libasan8 \
 && rm -rf /var/lib/apt/lists/*

# Build and install SRS.
COPY . /srs
WORKDIR /srs/trunk

# Note that we must enable the gcc7 or link failed.
# Please note that we must disable the ffmpeg-opus, as it negatively impacts performance. We may consider
# enabling it in the future when support for multi-threading transcoding is available.
# Enable sanitizer explicitly for CI/CD testing to catch memory issues.
RUN ./configure --srt=on --gb28181=on --srt=on --rtsp=on --apm=on --utest=on --sanitizer=on --ffmpeg-opus=off --build-cache=on
RUN make utest ${MAKEARGS}
RUN make install ${MAKEARGS}

# Make SRT headers/libs available at /usr/local for srs-bench CGO build.
# depends.sh installs libsrt under objs/srt; srs-bench uses -I/usr/local/include and -L/usr/local/lib
RUN set -eux; \
    if [ -d objs/srt/include/srt ]; then \
      mkdir -p /usr/local/include /usr/local/lib; \
      cp -rf objs/srt/include/srt /usr/local/include/; \
      cp -rf objs/srt/lib/* /usr/local/lib/ || true; \
      ldconfig || true; \
    fi

# Ensure OpenSSL lib path expected by srs-bench exists
RUN set -eux; \
    mkdir -p /usr/local/ssl; \
    if [ ! -d /usr/local/ssl/lib ]; then \
      ln -s /usr/lib/x86_64-linux-gnu /usr/local/ssl/lib || true; \
    fi

# Build benchmark tool.
RUN cd 3rdparty/srs-bench && make ${MAKEARGS}

