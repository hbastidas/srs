########################################################
FROM ubuntu:24.04 AS ubuntu24-cache-cross-armv7
COPY . /srs
RUN dpkg --add-architecture armhf \
 && printf "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports noble main restricted universe multiverse\n" > /etc/apt/sources.list.d/armhf.list \
 && printf "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports noble-updates main restricted universe multiverse\n" >> /etc/apt/sources.list.d/armhf.list \
 && printf "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports noble-security main restricted universe multiverse\n" >> /etc/apt/sources.list.d/armhf.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wget ca-certificates build-essential pkg-config git automake autoconf libtool cmake nasm yasm perl unzip xz-utils patch tclsh \
    gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf libopus-dev:armhf \
 && rm -rf /var/lib/apt/lists/*
ENV PKG_CONFIG_LIBDIR=/usr/lib/arm-linux-gnueabihf/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig
RUN cd /srs/trunk && ./configure --sanitizer=on --cross-build --cross-prefix=arm-linux-gnueabihf- --ffmpeg-opus=on && make

