########################################################
FROM ubuntu:noble AS ubuntu16-cache-cross-armv7
COPY . /srs
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wget ca-certificates build-essential pkg-config git automake autoconf libtool cmake nasm yasm perl unzip patch tclsh \
    gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf \
 && rm -rf /var/lib/apt/lists/*
RUN cd /srs/trunk && ./configure --sanitizer=on --cross-build --cross-prefix=arm-linux-gnueabihf- --ffmpeg-opus=on && make

