########################################################
FROM ubuntu:20.04 AS ubuntu20-baseline
COPY . /srs
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wget ca-certificates build-essential pkg-config git automake autoconf libtool cmake nasm yasm perl unzip xz-utils patch tclsh \
 && rm -rf /var/lib/apt/lists/*
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=off --gb28181=off && make

FROM ubuntu:20.04 AS ubuntu20-all
COPY . /srs
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wget ca-certificates build-essential pkg-config git automake autoconf libtool cmake nasm yasm perl unzip xz-utils patch tclsh \
 && rm -rf /var/lib/apt/lists/*
RUN cd /srs/trunk && ./configure --sanitizer=on --srt=on --gb28181=on --apm=on --h265=on && make

